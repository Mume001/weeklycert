# LF everywhere, also on Windows checkouts: Biome formats with LF and would
# otherwise fail `pnpm check` on every file after a fresh clone.
* text=auto eol=lf
*.woff2 binary
*.png binary
*.pdf binary
# Sample import files are exact bytes: CRLF, BOMs and Windows-1252 are what they test (spec/06 §8).
packages/core/src/import/__fixtures__/** -text
