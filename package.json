{
  "name": "weeklycert",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:mock": "cross-env DATA_SOURCE=mock pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --filter web build",
    "check": "biome check . && pnpm -r typecheck && tsc -p tsconfig.json && depcruise apps packages --config .dependency-cruiser.cjs && node scripts/check-gates.ts",
    "test": "vitest run",
    "e2e": "pnpm --filter web e2e && pnpm --filter site e2e",
    "format": "biome check --write .",
    "tokens:contrast": "node packages/ui-tokens/scripts/contrast.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "3.2.7",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
